# Required for SMS delivery
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
SMS_TO_NUMBER=+919876543210

# Use a Messaging Service SID (recommended) OR a Twilio sender number.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567

# Trial accounts only. Remove after upgrading to enable custom alert text.
TWILIO_TRIAL_TEMPLATE=sms_event_notifications
